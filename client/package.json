{
  "name": "rookie-clip",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "main": "electron/main.cjs",
  "scripts": {
    "lint": "eslint .",
    "preview": "vite preview",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "register-protocol": "electron . --register-protocol"
  },
  "build": {
    "appId": "com.rookieclip.app",
    "productName": "RookieClip",
    "icon": "public/assets/rookieclip3.ico",
    "copyright": "Copyright © 2025",
    "files": [
      "dist",
      "main.cjs",
      "preload.js",
      "assets/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "public/assets/rookieclip3.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "this-is-shreya",
        "repo": "video-recorder-and-editor"
      }
    ],
    "protocols": [
      {
        "name": "RookieClip Protocol",
        "schemes": [
          "rookieclip"
        ]
      }
    ]
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.30.4",
    "@dnd-kit/core": "^6.3.1",
    "@ffmpeg/core": "^0.12.4",
    "@ffmpeg/ffmpeg": "^0.12.7",
    "@ffmpeg/util": "^0.12.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@pixi/filter-color-replace": "^5.1.1",
    "@pixi/filter-outline": "^5.2.0",
    "@react-oauth/google": "^0.12.2",
    "@swc/wasm": "^1.11.13",
    "animate.css": "^4.1.1",
    "animejs": "^4.0.2",
    "baffle": "^0.3.6",
    "ccapture.js": "^1.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.1.0",
    "electron-updater": "^6.6.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.4.10",
    "gsap": "^3.12.7",
    "html2canvas": "^1.4.1",
    "lottie-react": "^2.4.1",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-cropper": "^2.3.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.5.0",
    "react-media-recorder": "^1.7.1",
    "react-player": "^2.16.0",
    "react-rnd": "^10.4.14",
    "react-router-dom": "^7.3.0",
    "react-toastify": "^11.0.5",
    "react-tooltip": "^5.28.1",
    "recordrtc": "^5.6.2",
    "styled-components": "^6.1.15",
    "three": "^0.174.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@swc/core": "^1.11.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "uglify-js": "^3.19.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.3"
  }
}
